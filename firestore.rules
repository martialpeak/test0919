rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
             data.email is string && data.email.size() <= 255 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200) || data.displayName == null) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2000) || data.photoURL == null) &&
             (!('createdAt' in data) || data.createdAt is string) &&
             (!('updatedAt' in data) || data.updatedAt is string);
    }

    function isValidTrackingItem(data, userId) {
      return data.userId == userId &&
             data.message_id is number &&
             (!('media_type' in data) || data.media_type is string) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 500) || data.title == null) &&
             (!('english_title' in data) || (data.english_title is string && data.english_title.size() <= 500) || data.english_title == null) &&
             (!('poster_url' in data) || (data.poster_url is string && data.poster_url.size() <= 2000) || data.poster_url == null) &&
             (!('status' in data) || data.status is string) &&
             (!('current_season' in data) || data.current_season is number || data.current_season == null) &&
             (!('last_episode' in data) || data.last_episode is number || data.last_episode == null) &&
             (!('total_episodes' in data) || data.total_episodes is number || data.total_episodes == null) &&
             (!('times_watched' in data) || data.times_watched is number || data.times_watched == null) &&
             (!('user_rating' in data) || data.user_rating is number || data.user_rating == null) &&
             (!('next_episode_date' in data) || (data.next_episode_date is string && data.next_episode_date.size() <= 100) || data.next_episode_date == null) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 4000) || data.note == null) &&
             (!('favorite' in data) || data.favorite is bool) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 200) || data.category == null) &&
             (!('year' in data) || (data.year is string && data.year.size() <= 50) || data.year is number || data.year == null) &&
             (!('updated_at' in data) || data.updated_at is number || data.updated_at is timestamp);
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId);
      allow delete: if isOwner(userId);

      // User Personal Tracking & Watchlist Subcollection
      match /tracking/{trackingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(trackingId) && isValidTrackingItem(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(trackingId) && isValidTrackingItem(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(trackingId);
      }
    }
  }
}
